# ---- docker compose (database service) ----
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432
N_PRICES=300000

# ---- Python pipeline connection (manual runs) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deals_bigdata
DB_USER=postgres
DB_PASSWORD=root

# ---- warehouse layers ----
DB_RAW_SCHEMA=raw
DB_CORE_SCHEMA=core
DB_MART_SCHEMA=mart

# ---- assignment snapshot ----
AS_OF_DATE=2026-10-26

# ---- performance (optional) ----
# Rows per streaming read chunk; memory is O(chunk), not O(table).
ETL_READ_CHUNK_ROWS=10000
