# Normalize line endings to LF and keep UTF-8 for all text files.
* text=auto

*.py     text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
Dockerfile* text eol=lf
requirements*.txt text eol=lf

# Never attempt to convert binary/archive assets.
*.html   text eol=lf

# Binary images
*.jpg  binary
*.jpeg binary
*.png  binary
